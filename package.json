{
  "name": "sika-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Sika Digital — agency website (SIK-01). Next.js 16 App Router, statically generated, deployed on Vercel.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",

    "gsap": "^3.13.0",
    "@gsap/react": "^2.1.2",
    "lenis": "^1.1.18",
    "motion": "^11.15.0",

    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1",

    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",

    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",

    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.4",
    "@eslint/eslintrc": "^3.2.0",

    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10"
  }
}
