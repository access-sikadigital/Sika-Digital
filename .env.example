# ─────────────────────────────────────────────────────────────────────────────
# SIKA DIGITAL — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never put a real secret in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, no trailing slash. Used for absolute URLs in metadata,
# sitemap.xml, robots.txt and JSON-LD. Set the real domain in Vercel for
# production and previews will fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://sikadigital.com

# ── Lead capture ─────────────────────────────────────────────────────────────
# GoHighLevel inbound webhook. The enquiry form posts to a server route, which
# forwards here. Server-side only: no NEXT_PUBLIC_ prefix, so it is never
# shipped to the browser.
#
# ⚠️  If this is unset, the form will accept a submission and deliver nothing.
#     The route logs loudly in that case rather than failing silently — but
#     check it is set before launch. A quote form that swallows leads is the
#     most expensive bug a lead-gen site can have.
GHL_WEBHOOK_URL=

# ── Analytics & tracking (Deliverable #11) ───────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Meta Conversions API — server-side, paired with the browser pixel for
# deduplicated events.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Google Ads enhanced conversions
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
